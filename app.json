{
  "expo": {
    "name": "Trabby",
    "slug": "trabby",
    "scheme": "trabby",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      ["expo-sensors", { "motionPermission": "Trabby가 걸음 수를 세기 위해 필요해요." }]
    ],
    "ios": { "supportsTablet": false, "infoPlist": { "NSMotionUsageDescription": "걸음 수를 세기 위해 필요해요." } },
    "android": { "permissions": ["android.permission.ACTIVITY_RECOGNITION"] }
  }
}
